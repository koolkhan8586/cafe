# ---------------------------------------------------------------------------
# Cafe LSAF configuration
# Copy to `.env` and fill in. Values marked (UI) can also be edited by an admin
# at /admin/settings, and the database value wins over the one here.
# ---------------------------------------------------------------------------

# Database. SQLite by default; the file is created on first migrate.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. REQUIRED in production, min 16 chars.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Shared HMAC secret with HR (koolkhan8586/hr-laravel). Same value as CAFE_SSO_SECRET
# on the HR side. Min 16 chars. When unset, /sso is disabled and PIN login still works.
HR_SSO_SECRET=""

# Branding (UI)
CAFE_NAME="Cafe LSAF"
CURRENCY_SYMBOL="Rs"
# Public URL of this Cafe (used as the Counter link in WhatsApp alerts).
CAFE_PUBLIC_URL="https://cafe.khanmusa.com"

# --- WAHA / WhatsApp -------------------------------------------------------
# WAHA is the WhatsApp HTTP API: https://waha.devlike.pro
# Base URL of your WAHA instance, no trailing slash. (UI)
WAHA_BASE_URL="http://localhost:3001"
# API key configured on the WAHA side as WHATSAPP_API_KEY. (UI)
WAHA_API_KEY=""
# WAHA session name; "default" unless you created another. (UI)
WAHA_SESSION="default"
# Where new-order alerts go. A phone number in international format without
# "+" (e.g. 923001234567) or a full chat id ("...@c.us", group "...@g.us"). (UI)
ADMIN_WHATSAPP_CHAT_ID=""
# Also WhatsApp the employee when their order status changes: "true"/"false". (UI)
NOTIFY_EMPLOYEE_ON_STATUS="false"
# WAHA should POST incoming messages here so ACCEPT / REJECT / COUNTER work.
# Example: https://cafe.khanmusa.com/api/waha/webhook
# WAHA_HOOK_URL is set on the WAHA container, not the Cafe app.
