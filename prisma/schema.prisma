// Cafe LSAF — data model
//
// Money is stored as an INTEGER number of minor units (e.g. paisa for PKR,
// cents for USD). Never store money as a float. Use the helpers in
// src/lib/money.ts to parse and format.
//
// SQLite does not support native enums, so status/role columns are TEXT and
// are constrained by the union types in src/lib/types.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A person who can log in: employee, cafe admin, or cafe manager.
model Staff {
  id         String   @id @default(cuid())
  /// Employee ID used as the login handle, e.g. "LSAF-014".
  code       String   @unique
  name       String
  department String?
  /// E.164-ish number without "+", e.g. "923001234567". Used for order updates.
  whatsapp   String?
  /// "EMPLOYEE" | "ADMIN" | "MANAGER"
  role       String   @default("EMPLOYEE")
  /// bcrypt hash of the PIN (employees) or password (admin/manager).
  pinHash    String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]
  ordersPlaced  Order[]       @relation("OrdersPlaced")
  ledgerEntries LedgerEntry[] @relation("LedgerOwner")
  ledgerAuthored LedgerEntry[] @relation("LedgerAuthor")
  expenses      Expense[]     @relation("ExpenseAuthor")

  @@index([role])
}

model Category {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)

  items MenuItem[]
}

model MenuItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  /// Selling price in minor units.
  price       Int
  /// What it costs the cafe to make, in minor units. Drives margin reporting.
  costPrice   Int     @default(0)
  available   Boolean @default(true)
  sortOrder   Int     @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([categoryId])
  @@index([available])
}

model Order {
  /// Doubles as the short human-facing order number shown on the board and in
  /// WhatsApp messages. SQLite only allows autoincrement on the primary key.
  id      Int    @id @default(autoincrement())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])
  /// "PENDING" | "PREPARING" | "READY" | "COMPLETED" | "CANCELLED"
  status  String @default("PENDING")
  notes   String?
  /// Department copied from the employee at order time, so reports stay
  /// correct even if someone later transfers between departments.
  department String?
  /// Sum of line totals, in minor units. Denormalised for fast reporting.
  subtotal   Int
  /// Sum of (unit cost x qty), in minor units. Denormalised for margin reports.
  totalCost  Int
  /// "CASH" | "CREDIT". A credit order posts a CHARGE to the staff ledger;
  /// a cash order is settled at the counter and never touches it.
  paymentMethod String @default("CASH")
  /// True when a manager or admin entered the order at the counter rather
  /// than the employee placing it themselves.
  isManual   Boolean @default(false)
  /// Who keyed in a manual order. Null for self-service orders.
  placedById String?
  placedBy   Staff?  @relation("OrdersPlaced", fields: [placedById], references: [id], onDelete: SetNull)
  /// Walk-in customer name, for manual cash orders with no staff account.
  /// When set, staffId still points at the person who rang it up.
  customerName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  completedAt DateTime?

  items         OrderItem[]
  notifications NotificationLog[]
  ledgerEntries LedgerEntry[]

  @@index([status])
  @@index([createdAt])
  @@index([staffId])
  @@index([paymentMethod])
}

/// Running account for an employee who orders on credit.
///
/// The balance is never stored: it is always sum(CHARGE) - sum(PAYMENT) over
/// this table, so a corrected or deleted entry can never leave a stale total
/// behind. Amounts are positive minor units; `type` carries the direction.
model LedgerEntry {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation("LedgerOwner", fields: [staffId], references: [id], onDelete: Cascade)
  /// "CHARGE" (an order on credit) | "PAYMENT" (they paid) |
  /// "ADJUSTMENT" (a manual correction, positive increases what they owe)
  type    String
  /// CHARGE and PAYMENT are always positive; their direction comes from
  /// `type`. ADJUSTMENT is the one entry that may be negative, to write off
  /// part of what someone owes.
  amount  Int
  /// Set for a CHARGE raised by a credit order; null for payments.
  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note    String?
  /// Who recorded it. Null if the staff member's own order raised the charge.
  createdById String?
  createdBy   Staff? @relation("LedgerAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([createdAt])
  @@index([orderId])
}

/// Money going out: supplies, rent, utilities and so on.
model Expense {
  id          String   @id @default(cuid())
  /// One of EXPENSE_CATEGORIES in src/lib/types.ts.
  category    String
  amount      Int
  /// The day the money was spent, which is not always the day it was entered.
  spentAt     DateTime
  note        String?
  createdById String?
  createdBy   Staff?   @relation("ExpenseAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([spentAt])
  @@index([category])
}

/// A line on an order. Price, cost and name are snapshotted at order time so
/// that later menu edits never rewrite history or past profit figures.
model OrderItem {
  id         String @id @default(cuid())
  orderId    Int
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  nameSnapshot String
  unitPrice  Int
  unitCost   Int
  qty        Int
  lineTotal  Int
  notes      String?

  @@index([orderId])
  @@index([menuItemId])
}

/// Audit trail of every outbound WhatsApp message attempt.
model NotificationLog {
  id        String  @id @default(cuid())
  orderId   Int?
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// "WHATSAPP"
  channel   String  @default("WHATSAPP")
  /// WAHA chat id the message was addressed to.
  target    String
  body      String
  /// "SENT" | "FAILED" | "SKIPPED"
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Runtime-editable configuration (WAHA credentials, currency, cafe name).
/// Values set here override the matching environment variable.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
