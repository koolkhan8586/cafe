# Cafe LSAF application service.
#
# Install:
#   sudo cp deploy/systemd/cafe-lsaf.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cafe-lsaf
#
# Logs:  sudo journalctl -u cafe-lsaf -f

[Unit]
Description=Cafe LSAF ordering app
Documentation=https://github.com/koolkhan8586/cafe
After=network-online.target
Wants=network-online.target

# Give up after 5 failed starts in 2 minutes and enter the "failed" state.
# Without this, Restart=always plus RestartSec=5 restart-loops forever on a
# permanent error such as EADDRINUSE: only two attempts fit in systemd's
# default 10s window, so the default burst limit of 5 never trips and
# `systemctl status` keeps reporting "active (running)" from the newest
# attempt while the service is in fact broken.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=cafe
Group=cafe
WorkingDirectory=/var/www/cafe

# Default port, listed BEFORE the EnvironmentFile so a PORT in .env overrides
# it. Having a default here means the app never falls back to Next's own 3000
# and silently stops matching nginx.
Environment=PORT=3003

# Reads PORT, DATABASE_URL, SESSION_SECRET and the WAHA_* settings.
# systemd parses KEY=value and KEY="value"; it does not run a shell, so no
# `export`, no command substitution, and no ${VAR} expansion in this file.
EnvironmentFile=/var/www/cafe/.env

# Listed after the EnvironmentFile so .env cannot accidentally unset it.
Environment=NODE_ENV=production

# Bind to loopback only — nginx is the only thing that should reach the app.
# The port comes from PORT above (Next.js reads it), so it is set in one place.
# If you change it, change proxy_pass in deploy/nginx/cafe-proxy.conf to match
# and check nothing else holds the new port first:
#   sudo ss -ltnp | grep :3003
# Calling the Next binary directly avoids an npx resolution step on every boot.
# `env` resolves node from PATH; if your node is somewhere unusual, check with
# `command -v node` and put the absolute path here instead.
ExecStart=/usr/bin/env node /var/www/cafe/node_modules/next/dist/bin/next start -H 127.0.0.1

Restart=always
RestartSec=5
# Give a slow first boot (migrations already ran, but startup can be cold).
TimeoutStartSec=60

# Basic hardening. ProtectSystem=full keeps /usr and /etc read-only; the
# database lives outside the app directory and is listed as writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/cafe-lsaf /var/www/cafe/.next

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cafe-lsaf

[Install]
WantedBy=multi-user.target
